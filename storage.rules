rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /events/{eventId}/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && request.resource.size < 100 * 1024 * 1024 && request.resource.contentType.matches('(image/.*|video/mp4|video/webm|video/quicktime)');
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /posts/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('(image/.*|video/mp4|video/webm|video/quicktime)');
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
