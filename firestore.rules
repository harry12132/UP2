rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function follows(uid) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(uid));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'photoURL', 'bio', 'createdAt', 'updatedAt'])
        && request.resource.data.displayName is string;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'updatedAt']);
      allow delete: if false;

      match /following/{targetUid} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) && targetUid != uid
          && request.resource.data.keys().hasOnly(['createdAt']);
        allow delete: if isSelf(uid);
        allow update: if false;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        resource.data.visibility == 'public' ||
        (resource.data.visibility == 'followers' && follows(resource.data.authorId)) ||
        (resource.data.visibility == 'selected' && request.auth.uid in resource.data.audienceUids)
      );
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.visibility in ['public', 'followers', 'selected']
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPhoto', 'text', 'visibility', 'audienceUids', 'createdAt']);
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /events/{eventId} {
      allow read: if signedIn() && (
        resource.data.visibility == 'public' ||
        resource.data.hostId == request.auth.uid ||
        request.auth.uid in resource.data.invitedUids ||
        request.auth.uid in resource.data.attendeeUids
      );
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.visibility in ['public', 'selected']
        && request.resource.data.keys().hasOnly(['hostId', 'hostName', 'title', 'description', 'location', 'startsAt', 'visibility', 'invitedUids', 'attendeeUids', 'createdAt', 'updatedAt']);
      allow update: if signedIn() && (
        (resource.data.hostId == request.auth.uid && request.resource.data.hostId == request.auth.uid) ||
        (request.auth.uid in resource.data.invitedUids &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeUids', 'updatedAt']) &&
          request.auth.uid in request.resource.data.attendeeUids)
      );
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn() && resource.data.actorId == request.auth.uid
        && resource.data.recipientId is string && resource.data.recipientId != request.auth.uid
        && resource.data.type in ['event_invite'];
      allow update: if signedIn() && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && resource.data.recipientId == request.auth.uid;
    }
  }
}
