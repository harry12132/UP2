rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function acceptedFollower(uid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/followRequests/$(uid)__$(request.auth.uid)) &&
        get(/databases/$(database)/documents/followRequests/$(uid)__$(request.auth.uid)).data.status == 'accepted';
    }
    function canReadPost(postId) {
      let postPath = /databases/$(database)/documents/posts/$(postId);
      return signedIn() && exists(postPath) && (
        get(postPath).data.authorId == request.auth.uid ||
        (acceptedFollower(get(postPath).data.authorId) &&
          (get(postPath).data.visibility != 'selected' ||
            request.auth.uid in get(postPath).data.audienceUids))
      );
    }
    function canReadEvent(eventId) {
      let eventPath = /databases/$(database)/documents/events/$(eventId);
      return signedIn() && exists(eventPath) && (
        get(eventPath).data.hostId == request.auth.uid ||
        request.auth.uid in get(eventPath).data.invitedUids ||
        request.auth.uid in get(eventPath).data.attendeeUids ||
        (get(eventPath).data.visibility == 'public')
      );
    }

    // Directory records contain only information safe to show before a follow is accepted.
    match /directory/{uid} {
      allow get, list: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        && request.resource.data.displayName is string;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;
    }

    // Full profile documents contain private bio and profile data.
    match /users/{uid} {
      allow get: if signedIn() && (isSelf(uid) || acceptedFollower(uid));
      allow list: if false;
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'photoURL', 'bio', 'createdAt', 'updatedAt'])
        && request.resource.data.displayName is string;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'createdAt', 'updatedAt']);
      allow delete: if false;

      match /following/{targetUid} {
        allow read: if isSelf(uid);
        allow create: if false;
        allow delete: if isSelf(uid);
        allow update: if false;
      }
    }

    // A follow request becomes the canonical follow relationship only when accepted.
    match /followRequests/{requestId} {
      allow get: if signedIn() && (requestId.matches('.*__' + request.auth.uid) || resource.data.targetId == request.auth.uid);
      allow list: if signedIn() && (resource.data.requesterId == request.auth.uid || resource.data.targetId == request.auth.uid || acceptedFollower(resource.data.targetId) || acceptedFollower(resource.data.requesterId));
      allow create: if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId != request.auth.uid
        && requestId == request.resource.data.targetId + '__' + request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['requesterId','requesterName','requesterPhoto','targetId','status','createdAt','updatedAt']);
      allow update: if signedIn() && (
        (resource.data.targetId == request.auth.uid && resource.data.status == 'pending' &&
          request.resource.data.requesterId == resource.data.requesterId &&
          request.resource.data.targetId == resource.data.targetId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) &&
          request.resource.data.status in ['accepted','declined']) ||
        (resource.data.requesterId == request.auth.uid && resource.data.status == 'declined' &&
          request.resource.data.requesterId == resource.data.requesterId &&
          request.resource.data.targetId == resource.data.targetId &&
          request.resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','createdAt','updatedAt','requesterName','requesterPhoto']))
      );
      allow delete: if signedIn() &&
        (resource.data.requesterId == request.auth.uid ||
          (resource.data.targetId == request.auth.uid && resource.data.status == 'pending'));
    }

    match /posts/{postId} {
      allow read: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        (acceptedFollower(resource.data.authorId) &&
          (resource.data.visibility != 'selected' ||
            request.auth.uid in resource.data.audienceUids))
      );
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.text is string
        && (request.resource.data.text.size() > 0 || ('mediaUrl' in request.resource.data))
        && request.resource.data.text.size() <= 2000
        && request.resource.data.visibility in ['public', 'followers', 'selected']
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPhoto', 'text', 'visibility', 'audienceUids', 'mediaUrl', 'mediaType', 'createdAt'])
        && (!('mediaUrl' in request.resource.data) || request.resource.data.mediaUrl is string)
        && (!('mediaType' in request.resource.data) || request.resource.data.mediaType in ['image', 'video']);
      allow update: if signedIn() && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'visibility', 'audienceUids']);
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{uid} {
        allow read: if canReadPost(postId);
        allow create: if canReadPost(postId) && isSelf(uid) && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'createdAt']);
        allow delete: if canReadPost(postId) && isSelf(uid);
        allow update: if false;
      }
      match /comments/{commentId} {
        allow read: if canReadPost(postId);
        allow create: if canReadPost(postId)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorPhoto', 'text', 'createdAt']);
        allow delete: if canReadPost(postId) && signedIn() && resource.data.authorId == request.auth.uid;
        allow update: if false;
      }
    }

    match /events/{eventId} {
      allow get, list: if signedIn() && (
        resource.data.visibility == 'public' ||
        resource.data.hostId == request.auth.uid ||
        request.auth.uid in resource.data.invitedUids ||
        request.auth.uid in resource.data.attendeeUids
      );
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.visibility in ['public', 'selected']
        && request.resource.data.keys().hasOnly(['hostId', 'hostName', 'title', 'description', 'location', 'startsAt', 'visibility', 'invitedUids', 'attendeeUids', 'createdAt', 'updatedAt']);
      allow update: if signedIn() && (
        (resource.data.hostId == request.auth.uid &&
          request.resource.data.hostId == resource.data.hostId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','location','startsAt','visibility','invitedUids','attendeeUids','updatedAt'])) ||
        ((request.auth.uid in resource.data.invitedUids || resource.data.visibility == 'public') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeUids', 'updatedAt']) &&
          request.resource.data.attendeeUids is list &&
          request.resource.data.attendeeUids.toSet().difference(resource.data.attendeeUids.toSet()).hasOnly([request.auth.uid]) &&
          resource.data.attendeeUids.toSet().difference(request.resource.data.attendeeUids.toSet()).hasOnly([request.auth.uid]))
      );
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;
    }

    match /events/{eventId}/photos/{photoId} {
      allow read: if canReadEvent(eventId) &&
        (get(/databases/$(database)/documents/events/$(eventId)).data.visibility == 'public' ||
         get(/databases/$(database)/documents/events/$(eventId)).data.hostId == request.auth.uid ||
         request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.invitedUids ||
         request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.attendeeUids);
      allow create: if canReadEvent(eventId) &&
        (get(/databases/$(database)/documents/events/$(eventId)).data.hostId == request.auth.uid ||
         request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.attendeeUids) &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.url is string &&
        request.resource.data.keys().hasOnly(['authorId','authorName','url','mediaType','createdAt']);
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    function validEventMembers(eventId, members) {
      let eventPath = /databases/$(database)/documents/events/$(eventId);
      return exists(eventPath) && members is list &&
        get(eventPath).data.hostId in members &&
        members.toSet().difference(get(eventPath).data.invitedUids.toSet()).hasOnly([get(eventPath).data.hostId]) &&
        get(eventPath).data.invitedUids.toSet().difference(members.toSet()).hasOnly([]);
    }
    function validConversation(conversationId) {
      let conversationPath = /databases/$(database)/documents/conversations/$(conversationId);
      return exists(conversationPath) && (
        (get(conversationPath).data.type == 'direct' &&
          get(conversationPath).data.members is list &&
          get(conversationPath).data.members.size() == 2) ||
        (get(conversationPath).data.type == 'event' &&
          get(conversationPath).data.eventId is string &&
          validEventMembers(get(conversationPath).data.eventId, get(conversationPath).data.members))
      );
    }

    match /conversations/{conversationId} {
      allow get: if signedIn() &&
        (!exists(/databases/$(database)/documents/conversations/$(conversationId)) ||
          (validConversation(conversationId) && request.auth.uid in resource.data.members));
      allow list: if signedIn() && validConversation(conversationId) && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 100
        && request.resource.data.type in ['direct','event']
        && request.resource.data.keys().hasOnly(['type','members','memberNames','title','eventId','eventTitle','lastMessage','lastSenderId','createdAt','updatedAt'])
        && ((request.resource.data.type == 'direct' && request.resource.data.members.size() == 2) ||
          (request.resource.data.type == 'event' && request.resource.data.eventId is string &&
           exists(/databases/$(database)/documents/events/$(request.resource.data.eventId)) &&
           get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.hostId == request.auth.uid &&
           validEventMembers(request.resource.data.eventId, request.resource.data.members)));
      allow update: if signedIn()
        && validConversation(conversationId)
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.type == resource.data.type
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','lastSenderId','updatedAt','memberNames','title','eventTitle']);
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if signedIn() && validConversation(conversationId) &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        allow create: if signedIn() && validConversation(conversationId) &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasOnly(['senderId','senderName','text','createdAt']);
        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId is string && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.type == 'event_invite'
        && request.resource.data.eventId is string
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.hostId == request.auth.uid
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.visibility == 'selected'
        && request.resource.data.recipientId in get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.invitedUids;
      allow update: if signedIn() && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && resource.data.recipientId == request.auth.uid;
    }
  }
}